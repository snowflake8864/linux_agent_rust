#!/bin/bash
### BEGIN INIT INFO
# Provides:          agent_manager
# Required-Start:    $network $remote_fs $syslog osec
# Required-Stop:     $network $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Agent Manager Service
# Description:       Linux Agent Manager Service - MagicArmorAgent
#chkconfig: 2345 81 19
#description: Agent Manager Service
### END INIT INFO

MONITOR_PID_FILE=/var/run/agent_manager_monitor.pid
BINARY_PID_FILE=/var/run/agent_manager.pid
MONITOR=/opt/osec/agent_manager_monitor

start() {
    if [ -f "$MONITOR_PID_FILE" ]; then
        OLD_PID=$(cat $MONITOR_PID_FILE)
        if [ -d "/proc/$OLD_PID" ]; then
            echo "agent_manager monitor is already running (PID: $OLD_PID)"
            return 0
        else
            rm -f $MONITOR_PID_FILE
        fi
    fi
    
    nohup $MONITOR >/dev/null 2>&1 &
    echo "agent_manager monitor started"
}

stop() {
    # Stop monitor first
    if [ -f "$MONITOR_PID_FILE" ]; then
        PID=$(cat $MONITOR_PID_FILE)
        if [ -d "/proc/$PID" ]; then
            kill -TERM $PID 2>/dev/null
            sleep 1
        fi
        rm -f $MONITOR_PID_FILE
    fi
    
    # Stop the actual process
    if [ -f "$BINARY_PID_FILE" ]; then
        PID=$(cat $BINARY_PID_FILE)
        if [ -d "/proc/$PID" ]; then
            kill -15 $PID 2>/dev/null
            sleep 1
            if [ -d "/proc/$PID" ]; then
                kill -9 $PID 2>/dev/null
            fi
        fi
        rm -f $BINARY_PID_FILE
    fi
    
    # Clean up any remaining processes
    pkill -9 -f "MagicArmorAgent" 2>/dev/null
    
    echo "agent_manager stopped"
}

status() {
    if [ -f "$MONITOR_PID_FILE" ]; then
        PID=$(cat $MONITOR_PID_FILE)
        if [ -d "/proc/$PID" ]; then
            echo "agent_manager monitor is running (PID: $PID)"
        else
            echo "agent_manager monitor is not running (stale PID file)"
        fi
    else
        echo "agent_manager monitor is not running"
    fi
    
    if [ -f "$BINARY_PID_FILE" ]; then
        PID=$(cat $BINARY_PID_FILE)
        if [ -d "/proc/$PID" ]; then
            echo "agent_manager process is running (PID: $PID)"
        else
            echo "agent_manager process is not running (stale PID file)"
        fi
    else
        echo "agent_manager process is not running"
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 2
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
