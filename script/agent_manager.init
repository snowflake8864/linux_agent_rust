#!/bin/bash
### BEGIN INIT INFO
# Provides:          agent_manager
# Required-Start:    $network $remote_fs $syslog osec
# Required-Stop:     $network $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Agent Manager Service
# Description:       Linux Agent Manager Service - MagicArmorAgent
#chkconfig: 2345 81 19
#description: Agent Manager Service
### END INIT INFO

NAME=agent_manager
# 主进程的 PID 文件（由 MagicArmorAgent 代码写入）
MAIN_PID_FILE=/var/run/agent_manager.pid
# monitor 进程的 PID 文件（由 monitor 脚本写入）
MONITOR_PID_FILE=/var/run/agent_manager_monitor.pid
MONITOR_SCRIPT=/opt/osec/agent_manager.monitor
BINARY=/opt/osec/MagicArmorAgent

start() {
    # 检查是否已在运行（检查主进程）
    if [ -f "$MAIN_PID_FILE" ]; then
        OLD_PID=$(cat $MAIN_PID_FILE 2>/dev/null)
        if [ -n "$OLD_PID" ] && [ -d "/proc/$OLD_PID" ]; then
            echo "$NAME is already running (PID: $OLD_PID)"
            return 0
        else
            rm -f $MAIN_PID_FILE
        fi
    fi

    if [ ! -f "$MONITOR_SCRIPT" ]; then
        echo "Monitor script not found: $MONITOR_SCRIPT"
        return 1
    fi

    chmod +x $MONITOR_SCRIPT
    bash $MONITOR_SCRIPT start
    echo "$NAME started"
}

stop() {
    # 调用 monitor 的 stop 来停止主进程和 monitor
    if [ -f "$MONITOR_SCRIPT" ]; then
        $MONITOR_SCRIPT stop 2>/dev/null
    else
        # 如果 monitor 脚本不存在，直接清理
        if [ -f "$MAIN_PID_FILE" ]; then
            PID=$(cat $MAIN_PID_FILE 2>/dev/null)
            if [ -n "$PID" ] && [ -d "/proc/$PID" ]; then
                kill -15 $PID 2>/dev/null
                sleep 1
                kill -9 $PID 2>/dev/null || true
            fi
            rm -f $MAIN_PID_FILE
        fi
        if [ -f "$MONITOR_PID_FILE" ]; then
            PID=$(cat $MONITOR_PID_FILE 2>/dev/null)
            if [ -n "$PID" ] && [ -d "/proc/$PID" ]; then
                kill -9 $PID 2>/dev/null || true
            fi
            rm -f $MONITOR_PID_FILE
        fi
    fi
    echo "$NAME stopped"
}

status() {
    # 检查主进程是否运行
    if [ -f "$MAIN_PID_FILE" ]; then
        PID=$(cat $MAIN_PID_FILE 2>/dev/null)
        if [ -n "$PID" ] && [ -d "/proc/$PID" ]; then
            echo "$NAME is running (PID: $PID)"
            return 0
        else
            echo "$NAME is not running (stale PID file)"
            return 1
        fi
    else
        echo "$NAME is not running"
        return 3
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 2
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
